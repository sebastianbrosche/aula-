{
  "name": "aula",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @aula/worker dev",
    "dev:node": "pnpm --filter @aula/node start",
    "test": "vitest run",
    "check": "biome check . && pnpm typecheck",
    "typecheck": "pnpm -r --parallel typecheck",
    "db:generate": "pnpm --filter @aula/core db:generate",
    "db:migrate": "pnpm --filter @aula/worker db:migrate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
