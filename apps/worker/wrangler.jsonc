{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "aula",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEMO_LOGIN": "1",
    "GIT_SHA": "9053e40d2e1d1579773f62d45525f3b660da2e31"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aula",
      "database_id": "7da0a62a-de3e-4042-a8f9-92ee21b6821f",
      "migrations_dir": "../../packages/core/src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "aula-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "55d78d959c434529bca384336f5c683a"
    }
  ]
}
